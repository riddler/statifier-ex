diff --git a/lib/statifier/compiler.ex b/lib/statifier/compiler.ex
--- a/lib/statifier/compiler.ex
+++ b/lib/statifier/compiler.ex
@@ -789,7 +789,36 @@ defmodule Statifier.Compiler do
   defp build_cond(%DTransition{cond: nil}, _t_index), do: {:ok, nil}
 
   defp build_cond(%DTransition{cond: source} = transition, t_index) do
-    Expressions.compile(source, {:transition, t_index}, cond_location(transition))
+    trimmed = String.trim_leading(source)
+    skipped = binary_part(source, 0, byte_size(source) - byte_size(trimmed))
+    anchor = advance_anchor(cond_location(transition), skipped)
+
+    Expressions.compile(trimmed, {:transition, t_index}, anchor)
+  end
+
+  # `Statifier.Parser.Location.resolve_span/4` requires the compiled value's
+  # `{1, 1}` to be the anchor's start, so a caller that trims must move the
+  # anchor by exactly what it skipped - counting newlines in the skipped
+  # prefix, not just its length, so a leading blank line advances the line
+  # and not merely the column.
+  @spec advance_anchor(location :: Location.t(), skipped :: binary()) :: Location.t()
+  defp advance_anchor(location, ""), do: location
+
+  defp advance_anchor(%Location{start_line: line, start_column: column} = location, skipped) do
+    {added_lines, last_line_length} =
+      case String.split(skipped, "\n") do
+        [only] -> {0, String.length(only)}
+        lines -> {length(lines) - 1, String.length(List.last(lines))}
+      end
+
+    new_column = if added_lines == 0, do: column + last_line_length, else: last_line_length + 1
+
+    %{
+      location
+      | start_line: line + added_lines,
+        start_column: new_column,
+        start_offset: location.start_offset + byte_size(skipped)
+    }
   end
 
   # `attribute_locations[:cond]`'s value span when the author wrote `cond`
