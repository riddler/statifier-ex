# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where third-party dependencies like ExDoc output generated docs.
/doc/

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Ignore package tarball (built via "mix hex.build").
statifier-*.tar

# Temporary files, for example, from tests.
/tmp/

# Changelog fragments are tracked. A global gitignore rule for `*.d` (C/C++
# dependency files) matches this directory name and would otherwise hide them.
!changelog.d/

# Corpus generator scratch space: upstream downloads (W3C TXML, Saxon-HE, the
# SCION framework clone) and intermediate artifacts. No upstream artifact is
# committed; only the generated test modules under test/{scion,scxml}_tests/ are.
/tools/corpus/scratch/

# Fetched W3C SCXML REC and its extracted Appendix D pseudocode (see
# tools/spec/README.md). A local reading aid, not conformance corpus
# material: the W3C Document License covers verbatim redistribution of the
# REC, not an extracted subset, so this never gets vendored into the repo.
/tools/spec/scratch/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
